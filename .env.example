# --- Puck CMS editor ---------------------------------------------------------
# Shared secret used by your separate admin app to sign the editor JWT (HS256).
EDITOR_JWT_SECRET=change-me-to-a-long-random-string
# Optional: expected `iss` / `aud` claims on the token.
EDITOR_JWT_ISSUER=
EDITOR_JWT_AUDIENCE=
# Max editor session in seconds (token exp is honoured, but never longer than this). 1800 = 30 min.
EDITOR_SESSION_MAX_AGE=1800
# Where users are sent when the token is missing/expired. `{path}` is replaced by the page path.
ADMIN_URL=http://localhost:4000
ADMIN_REDIRECT_PATH=/pages/edit?path={path}

# --- Content backend ---------------------------------------------------------
# Your admin's REST API. If empty, pages are stored in ./.data/pages (dev only).
#   GET  {CMS_API_URL}/pages?path=/about  -> { path, data, seo? } | 404
#   PUT  {CMS_API_URL}/pages               body { path, data }   (Authorization: Bearer <editor token>)
CMS_API_URL=
# Public base URL used for canonical/OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

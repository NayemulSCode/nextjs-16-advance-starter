# --- Puck CMS editor ---------------------------------------------------------
# Shared secret used by your separate admin app to sign the editor JWT (HS256).
EDITOR_JWT_SECRET=change-me-to-a-long-random-string
# Optional: expected `iss` / `aud` claims on the token.
EDITOR_JWT_ISSUER=
EDITOR_JWT_AUDIENCE=
# Max editor session in seconds (token exp is honoured, but never longer than this). 1800 = 30 min.
EDITOR_SESSION_MAX_AGE=1800
# Where users are sent when the token is missing/expired. `{path}` is replaced by the page path.
ADMIN_URL=http://localhost:4000
ADMIN_REDIRECT_PATH=/pages/edit?path={path}

# --- Content + media backend -------------------------------------------------
# LOCAL MODE (default, leave CMS_API_URL empty): pages -> ./.data/pages, uploads -> ./.data/uploads.
# LIVE MODE: set CMS_API_URL to your admin/backend. Pages and uploads then go to (and are read from) it.
CMS_API_URL=
#   GET  {CMS_API_URL}{CMS_PAGES_PATH}?path=/about  -> { path, data } | { page: { data } } | Puck data | 404
#   PUT  {CMS_API_URL}{CMS_PAGES_PATH}              body { path, data, updatedAt }   (Bearer <editor token>)
#   POST {CMS_MEDIA_URL}  multipart `file`          -> { url } (also accepts data.url / location / file.url / path)
CMS_PAGES_PATH=/pages
CMS_MEDIA_PATH=/media
# CMS_MEDIA_URL=https://media.example.com/upload   # full override of the upload endpoint
# CMS_MEDIA_BASE_URL=https://cdn.example.com       # prefix for relative URLs the backend returns
# Optional key sent as X-API-Key when the live site reads published pages
CMS_API_KEY=
# Public pages are cached this many seconds; the webhook below refreshes them instantly
CMS_REVALIDATE_SECONDS=60
# Backend calls POST /api/revalidate {path} with header x-revalidate-secret after a change
CMS_REVALIDATE_SECRET=

# Public base URL used for canonical/OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

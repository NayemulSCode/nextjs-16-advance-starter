  { "id": "q002", "text_bn": "মুই কোটে যাং?", "text_en": "\"Mui kote jang?\" (Where shall I go?)", "answers": ["rangpur", "lalmonirhat", "kurigram", "nilphamari", "gaibandha"], "decoys": ["barishal", "khulna", "chattogram"], "note_bn": "'মুই' ও 'কোটে' রংপুর অঞ্চলে শোনা যায়।", "note_en": "'Mui' (I) and 'kote' (where) are heard across the Rangpur region.", "verified": false },
